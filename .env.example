# Copy to .env and fill in. Never commit .env.
# Blank values are yours to fill in. Filled values are safe local defaults, not secrets.

# --- Fill these in (slice 1) ---
# Sent to the SEC on every EDGAR request. Format: Your Name your@email.com
FL_SEC_USER_AGENT=
# Groq: change summaries on your holdings (private requests)
GROQ_API_KEY=
# Gemini (Google AI Studio): anything involving only public filing text
GEMINI_API_KEY=

# --- Fill this in (slice 2) ---
# Hosted Neon Postgres, pooled connection string. Used only by the deployed app.
DATABASE_URL=
# Hosted Neon Postgres, direct connection. Alembic migrations against Neon only.
DATABASE_URL_UNPOOLED=

# --- Safe defaults: leave as is ---
# Local Postgres from docker-compose on port 5433. Development and tests use this, never Neon.
FL_DATABASE_URL=postgresql://filinglens:filinglens@localhost:5433/filinglens
FL_DATA_DIR=./data
# Set to replay to forbid LLM calls (tests and CI do this)
# FL_LLM_MODE=live
FL_HOLDINGS_FILE=./holdings.local.toml
# Unused until CRSP access arrives; must stay outside the repo
FL_LICENSED_DIR=~/filinglens-licensed


#extra from neon
NEON_BRANCH=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
